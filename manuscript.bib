@article{ZhangYukun2025.doi.10.1002/wcms.70020,
  author   = {Zhang, Yukun and Zhang, Xiaoming and Sun, Jinzhao and Lin, Heng and Huang, Yifei and Lv, Dingshun and Yuan, Xiao},
  title    = {Quantum Algorithms for Quantum Molecular Systems: A Survey},
  journal  = {WIREs Computational Molecular Science},
  volume   = {15},
  number   = {3},
  pages    = {e70020},
  keywords = {fault-tolerant quantum algorithms, quantum computational chemistry, quantum computing},
  doi      = {https://doi.org/10.1002/wcms.70020},
  url      = {https://wires.onlinelibrary.wiley.com/doi/abs/10.1002/wcms.70020},
  note     = {e70020 CMS-1125.R1},
  abstract = {ABSTRACT Solving quantum molecular systems presents a significant challenge for classical computation. The advent of early fault-tolerant quantum computing devices offers a promising avenue to address these challenges, leveraging advanced quantum algorithms with reduced hardware requirements. This review surveys the latest developments in quantum computing algorithms for quantum molecular systems in the fault-tolerant quantum computing era, covering encoding schemes, advanced Hamiltonian simulation techniques, and ground-state energy estimation methods. We highlight recent progress in overcoming practical barriers, such as reducing circuit depth and minimizing the use of ancillary qubits. Special attention is given to the potential quantum advantages achievable through these algorithms, as well as the limitations imposed by dequantization and classical simulation techniques. The review concludes with a discussion of future directions, emphasizing the need for optimized algorithms and experimental validation to bridge the gap between theoretical developments and practical implementation for quantum molecular systems.},
  year     = {2025}
}

